#!/usr/bin/env python3
"""Kostenbegrenzter Einstieg fuer OpenAI Codex Security."""

import argparse
import importlib.util
import pathlib
import subprocess
import sys

_BUDGET = pathlib.Path(__file__).resolve().parent / "model_budget.py"
if not _BUDGET.exists():
    sys.exit(f"FEHLER: {_BUDGET} fehlt.\nUnvollstaendiger Sync: tools/guard sync")
_spec = importlib.util.spec_from_file_location("guard_model_budget", _BUDGET)
budget = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(budget)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", default=".")
    parser.add_argument("--max-cost", type=float)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument(
        "scan_args",
        nargs=argparse.REMAINDER,
        help="Argumente fuer codex-security scan, nach --",
    )
    args = parser.parse_args()

    repo = pathlib.Path(args.repo).resolve()
    if not (repo / ".git").exists():
        print(f"FEHLER: kein Git-Repo: {repo}", file=sys.stderr)
        return 2
    scan_args = list(args.scan_args)
    if scan_args[:1] == ["--"]:
        scan_args = scan_args[1:]
    if "--max-cost" in scan_args:
        print("FEHLER: --max-cost gehoert vor das trennende --.", file=sys.stderr)
        return 2
    if not args.dry_run and (args.max_cost is None or args.max_cost <= 0):
        print("FEHLER: ein echter Security-Scan braucht --max-cost groesser 0.", file=sys.stderr)
        return 2

    command = ["npx", "codex-security", "scan", str(repo)]
    if args.dry_run:
        command.append("--dry-run")
        model_start = None
    else:
        command.extend(["--max-cost", str(args.max_cost)])
        try:
            model_start = budget.reserve(
                repo,
                "security",
                detail=" ".join(scan_args),
            )
        except budget.ModelBudgetError as exc:
            print(f"MODELLBUDGET: FEHLER - {exc}", file=sys.stderr)
            return 2
        if not model_start["allowed"]:
            print(
                "MODELLBUDGET: LIMIT ERREICHT "
                f"({model_start['total_used']}/{model_start['total_limit']} gesamt, "
                f"Security {model_start['tool_used']}/{model_start['tool_limit']}).",
                file=sys.stderr,
            )
            print("Kein Security-Modell gestartet.", file=sys.stderr)
            return 2
    command.extend(scan_args)

    try:
        result = subprocess.run(command, cwd=repo)
    except OSError as exc:
        if model_start is not None:
            budget.release(repo, model_start, "npx-Prozess konnte nicht gestartet werden")
        print(f"SECURITY NICHT GELAUFEN: {exc}", file=sys.stderr)
        return 2
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
