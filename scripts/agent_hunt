#!/usr/bin/env python3
"""Cross-Model-Hunt: ein ZWEITES Modell sucht die Root Cause eines Bugs.

Sinn: Ein Modell, das seinen eigenen Bug jagt, sucht dort, wo es den Code
ohnehin schon verstanden zu haben glaubt. Der Wert liegt in der
Modell-Diversitaet - ein frischer Blick ohne die Vorannahmen der Session.

  tools/agent_hunt "Beschreibung des Problems"
  tools/agent_hunt --repo kurier "Cronjob schreibt seit 3 Tagen keine Zeilen"
  tools/agent_hunt --hint "Verdacht: ranker.ts" "Shorts bekommen falsches Topic"

Der Ermittler laeuft READ-ONLY und liefert Hypothesen mit Belegstellen - KEINE
Fixes. Das Ergebnis landet in <repo>/.agents/hunts/<ts>.md und wird in
.agents/command_runs.jsonl als Evidenz protokolliert.

Backend ist die lokale codex-CLI. Fehlt sie oder der Zugang, bricht das Script
ehrlich ab, statt eine Analyse vorzutaeuschen.
"""

import argparse
import importlib.util
import pathlib
import re
import sys

# codex_backend.py liegt neben diesem Script und traegt den Teil, den sich alle
# drei Cross-Model-Werkzeuge teilen. Bewusst per Pfad geladen statt per
# `import codex_backend`: unter dem Test-Loader steht dieses Verzeichnis nicht
# in sys.path, und in den Ziel-Repos liegt scripts/ voller Projekt-Dateien - es
# an sys.path[0] zu haengen koennte Stdlib-Module beschatten. .resolve() folgt
# dem Symlink aus tools/.
_BACKEND = pathlib.Path(__file__).resolve().parent / "codex_backend.py"
if not _BACKEND.exists():
    sys.exit(f"FEHLER: {_BACKEND} fehlt.\nUnvollstaendiger Sync: tools/guard sync")
_spec = importlib.util.spec_from_file_location("guard_codex_backend", _BACKEND)
codex = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(codex)

# Bewusst terra, NICHT sol: agent_review laeuft seit 2026-07-31 auf sol, weil
# es das Gate bedient und ein Fehler dort am teuersten ist. Hier bleibt terra.
# Alle drei Werkzeuge teilen EINEN Kontingent-Pool - sol ueberall waere der
# schnellste Weg, das Review-Gate per leerem Kontingent selbst zu blockieren.
DEFAULT_MODEL = "gpt-5.6-terra"

HUNT_INSTRUCTIONS = """Du bist ein Root-Cause-Ermittler in einem fremden Repository.
Deine Aufgabe ist DIAGNOSE, nicht Reparatur. Du arbeitest read-only.

Problem:
{problem}
{hint_block}
Vorgehen:
1. Reproduziere den Fehlerpfad gedanklich anhand des Codes (Dateien lesen,
   greppen, Git-History ansehen - was immer read-only geht).
2. Bilde Hypothesen und pruefe jede gegen den tatsaechlichen Code, bevor du
   sie meldest. Eine Hypothese ohne Belegstelle ist keine.
3. Unterscheide klar: belegte Ursache vs. plausible Vermutung.

Antwortformat (Markdown):
## Root-Cause-Hypothesen (absteigend nach Konfidenz)
Pro Hypothese:
- **These:** ein Satz
- **Konfidenz:** hoch / mittel / niedrig
- **Beleg:** Datei:Zeile plus kurzes Zitat des relevanten Codes
- **Mechanismus:** wie genau fuehrt das zum beobachteten Verhalten
- **Verifikation:** welcher konkrete Check/Testlauf wuerde die These bestaetigen
  oder widerlegen (nur benennen, nicht ausfuehren, wenn er Schreibzugriff braucht)

## Ausgeschlossen
Was du geprueft und verworfen hast, mit Begruendung.

Keine Fixes vorschlagen, bevor die Ursache steht. Wenn du nichts Belastbares
findest, sag das ehrlich - eine leere Hypothesenliste ist besser als eine
erfundene."""


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("problem", help="Beschreibung des beobachteten Fehlverhaltens")
    ap.add_argument("--repo", default=".", help="Repo-Pfad (Default: aktuelles Verzeichnis)")
    ap.add_argument(
        "--hint",
        help="optionaler Hinweis (Verdachtsdateien, Zeitpunkt, Repro-Schritte)",
    )
    ap.add_argument(
        "--model",
        default=DEFAULT_MODEL,
        help=f"Modell des Ermittlers (Default: {DEFAULT_MODEL})",
    )
    ap.add_argument(
        "--effort",
        default=codex.DEFAULT_EFFORT,
        choices=codex.EFFORT_CHOICES,
        help=f"Reasoning-Effort, gedeckelt bei medium (Default: {codex.DEFAULT_EFFORT})",
    )
    args = ap.parse_args()

    repo = pathlib.Path(args.repo).resolve()
    if not (repo / ".git").exists():
        print(f"FEHLER: kein Git-Repo: {repo}", file=sys.stderr)
        return 2

    backend_bin = codex.find_codex()
    if not backend_bin:
        print("FEHLER: codex-CLI nicht gefunden. Kein Zweitmodell = kein Hunt.", file=sys.stderr)
        print("Keine Analyse vorzutaeuschen ist besser als eine erfundene.", file=sys.stderr)
        return 2

    try:
        model_start = codex.budget.reserve(repo, "hunt", detail=args.problem)
    except codex.budget.ModelBudgetError as exc:
        print(f"MODELLBUDGET: FEHLER - {exc}", file=sys.stderr)
        return 2
    if not model_start["allowed"]:
        print(
            "MODELLBUDGET: LIMIT ERREICHT "
            f"({model_start['total_used']}/{model_start['total_limit']} gesamt, "
            f"Hunt {model_start['tool_used']}/{model_start['tool_limit']}).",
            file=sys.stderr,
        )
        print("Kein Zweitmodell gestartet.", file=sys.stderr)
        return 2

    hint_block = f"\nHinweis vom Auftraggeber:\n{args.hint}\n" if args.hint else ""
    prompt = HUNT_INSTRUCTIONS.format(problem=args.problem, hint_block=hint_block)

    print(f"Zweitmodell ermittelt in: {repo.name} [codex: {args.model}, effort={args.effort}]")
    print(f"Problem: {args.problem}\n")

    cmd = codex.read_only_cmd(backend_bin, args.model, args.effort, prompt)
    try:
        output, returncode = codex.run(cmd, repo)
    except OSError as exc:
        codex.budget.release(repo, model_start, "codex-Prozess konnte nicht gestartet werden")
        print(f"HUNT NICHT GELAUFEN: {exc}", file=sys.stderr)
        return 2

    failure = codex.classify_failure(output, returncode)
    if failure:
        codex.budget.release(repo, model_start, f"codex-Lauf nicht gestartet: {failure}")
        codex.report_failure(failure, "HUNT", output)
        codex.record_command(repo, "agent_hunt", 2)
        return 2

    print(output)

    hunts = repo / ".agents" / "hunts"
    hunts.mkdir(parents=True, exist_ok=True)
    stamp = codex.now().replace(":", "").replace("-", "")
    slug = re.sub(r"[^a-z0-9]+", "-", args.problem.lower())[:40].strip("-") or "hunt"
    out_file = hunts / f"{stamp}-{slug}.md"
    out_file.write_text(
        f"# Cross-Model-Hunt\n\n"
        f"- Zeitpunkt: {codex.now()}\n"
        f"- Repo: {repo.name}\n"
        f"- Problem: {args.problem}\n"
        + (f"- Hinweis: {args.hint}\n" if args.hint else "")
        + f"- Backend: codex ({backend_bin}, Modell {args.model})\n"
        f"- Exit: {returncode}\n\n"
        f"---\n\n{output}\n",
        encoding="utf-8",
    )

    codex.record_command(repo, "tools/agent_hunt", returncode)

    print(f"\nHunt gespeichert: {out_file.relative_to(repo)}")
    if returncode != 0:
        print(
            "HINWEIS: Ermittler endete mit Fehler - Ergebnis ist unvollstaendig.",
            file=sys.stderr,
        )
    return returncode


if __name__ == "__main__":
    sys.exit(main())
